# ESP32S3 and INMP441 Microphone and MAX98357A Digital Amplifier Connections

- **ESP32S3 GPIO25** → **INMP441 WS**
- **ESP32S3 GPIO26** → **INMP441 SCK**
- **ESP32S3 GPIO27** → **INMP441 SD**
- **ESP32S3 GPIO16** → **MAX98357A DIN**
- **ESP32S3 GPIO17** → **MAX98357A BCLK**
- **ESP32S3 GPIO18** → **MAX98357A LRC**

# INMP441 I2S Config

i2s_chan_config_t audio_input_i2s_chan_cfg = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);

i2s_std_config_t audio_input_i2s_cfg = {
    .clk_cfg  = I2S_STD_CLK_DEFAULT_CONFIG(48000),
    .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_32BIT, I2S_SLOT_MODE_MONO),
    .gpio_cfg =
        {
            .mclk = -1,
            .bclk = GPIO_NUM_26,
            .ws   = GPIO_NUM_25,
            .dout = -1,
            .din  = GPIO_NUM_27,
            .invert_flags =
                {
                    .mclk_inv = 0,
                    .bclk_inv = 0,
                    .ws_inv   = 0,
                },
        },
};

# MAX98357A I2S Config

i2s_chan_config_t audio_output_i2s_chan_cfg = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_1, I2S_ROLE_MASTER);

i2s_std_config_t audio_output_i2s_cfg = {
    .clk_cfg  = I2S_STD_CLK_DEFAULT_CONFIG(48000),
    .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_32BIT, I2S_SLOT_MODE_MONO),
    .gpio_cfg = {
        .mclk         = -1,
        .bclk         = GPIO_NUM_17,
        .ws           = GPIO_NUM_18,
        .dout         = GPIO_NUM_16,
        .din          = -1,
        .invert_flags = {
            .mclk_inv = 0,
            .bclk_inv = 0,
            .ws_inv   = 0,
        },
    },
};